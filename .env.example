# CommonGround hosted private-beta is DISABLED unless configured and explicitly enabled.
# Migration-owner credentials belong in your local secrets manager, never in Vercel.
# DATABASE_MIGRATION_URL=postgresql://migration-user:...@host/database

# Server-only Vercel env, use a NON-OWNER, NON-BYPASSRLS runtime role.
DATABASE_RUNTIME_URL=
AUTH_TOKEN_PEPPER=
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_ORIGIN=https://commonground-nu.vercel.app
SHARED_BETA_ENABLED=false
# Only for local development when required. Always TLS in production.
# DATABASE_SSL=disable
